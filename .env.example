# Copia in .env e adatta. Valori pensati per compose.yaml + compose.local.yaml.

# In locale docker compose unisce la base sicura e le aggiunte di sviluppo.
COMPOSE_FILE=compose.yaml:compose.local.yaml

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_DB=catalog
POSTGRES_PORT=5433
DATABASE_URL=postgresql://catalog:catalog@localhost:5433/catalog

# --- OpenSearch -----------------------------------------------------------
# Sicurezza attiva (compose.yaml): utente anonimo in sola lettura, utente indexer, admin.
# Password robuste (maiuscole, minuscole, cifre e simboli), per esempio:
#   echo "Os$(openssl rand -hex 8)Aa1!"
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
OPENSEARCH_PORT=9200
# http in locale (compose.local.yaml toglie il TLS sull'HTTP); https nella sola base.
OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_HTTP_TLS=true
# Utente dell'indexer (creato da infra/opensearch/setup.sh)
OPENSEARCH_USER=indexer
OPENSEARCH_PASS=
# Certificato della CA, se OpenSearch usa HTTPS con un certificato non pubblico
# OPENSEARCH_CA_FILE=
# Origine del catalogo che legge dal browser (CORS)
OPENSEARCH_CORS_ORIGIN=http://localhost:3000
# Alias pubblico letto dal catalogo (compatibile con l'indice attuale).
OPENSEARCH_INDEX_ALIAS=developers_italia_it

# Porta di Prisma Studio nel compose locale (bun run db:studio)
# PRISMA_STUDIO_PORT=5555

# --- API ------------------------------------------------------------------
API_PORT=3001
# Origini ammesse dal browser (CORS), separate da virgola: il catalogo pubblico legge
# /v2/vocabularies e /v2/ipa-entities. Senza, tutte.
# CORS_ORIGINS=http://localhost:3000
# Base dell'API v2 usata da crawler, indexer e dashboard
API_BASEURL=http://localhost:3001/v2
# Base del catalogo pubblico: /v2/search restituisce i link alle schede (<base>/software/<id>)
CATALOG_PUBLIC_URL=http://localhost:3000

# --- Server MCP (apps/mcp) ---------------------------------------------------
# Usa API_BASEURL. Porta e limite di richieste al minuto per IP del trasporto HTTP.
MCP_PORT=3002
MCP_RATE_LIMIT=120
# Esempio di assistente che usa il server MCP (bun run mcp:openrouter): chiave da
# https://openrouter.ai/keys; ogni esecuzione è a pagamento. Modello facoltativo
# (default openai/gpt-4o-mini; qualunque modello OpenRouter che supporti gli strumenti).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Token per le scritture v2 (provvisori, separati da virgola): `Authorization: Bearer <token>`.
# Senza token l'API v2 è in sola lettura. Genera con: openssl rand -hex 24
# API_TOKENS=
# Token usato da crawler e indexer verso l'API (uno di quelli in API_TOKENS). Serve al
# crawler per scrivere e a entrambi per registrare le esecuzioni in job_runs (cruscotto).
# API_BEARER_TOKEN=
# Chi ha avviato crawler, indexer e sync IndicePA, registrato con l'esecuzione (default manual)
# JOB_TRIGGER=manual
# Commit in esecuzione, mostrato nello stato degli strumenti (es. impostato dal deploy)
# GIT_COMMIT=
# Chiave simmetrica PASETO v2 (32 byte in base64) per la v1, quando sarà implementata.
# PASETO_KEY=

# --- Crawler --------------------------------------------------------------
# Letto anche dall'API: lo stato degli strumenti mostra le richieste rimaste
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# GITEA_TOKEN=
# MAIN_PUBLISHER_ID=
# Vitalità calcolata con le API dei code hosting (D6): giorni considerati, o salta il calcolo
ACTIVITY_DAYS=60
SKIP_VITALITY=false

# --- Dashboard: accesso con magic link ------------------------------------
# URL pubblico della dashboard, usato per costruire i link nelle email
DASHBOARD_URL=http://localhost:5173
# Domini autorizzati, separati da virgola. Il confronto è esatto sul dominio
# dell'indirizzo (niente sottodomini, niente "endsWith" sull'intera stringa).
DASHBOARD_ALLOWED_EMAIL_DOMAINS=innovazione.gov.it,agid.gov.it
# Singoli indirizzi autorizzati oltre ai domini (facoltativo, separati da virgola)
# DASHBOARD_ALLOWED_EMAILS=
# Indirizzi con ruolo ADMIN, separati da virgola: possono modificare. Tutti gli altri
# indirizzi ammessi sono VIEWER (sola lettura). Il ruolo viene ricalcolato a ogni accesso:
# togliere un indirizzo da qui gli toglie i permessi di modifica dal login successivo.
# Gli indirizzi admin possono accedere anche se il loro dominio non è tra quelli ammessi.
# DASHBOARD_ADMIN_EMAILS=nome.cognome@innovazione.gov.it,altro.nome@agid.gov.it
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_HOURS=8
# Validità del link di conferma inviato alla PEC dell'ente (onboarding)
ONBOARDING_CONFIRM_TTL_HOURS=72
# true solo se l'API è dietro un proxy fidato: il rate limit usa allora X-Forwarded-For
TRUST_PROXY=false

# --- Anagrafica IndicePA (bun run ipa:sync) ---------------------------------
# API CKAN degli open data IndicePA (dataset "Enti")
# IPA_CKAN_URL=https://indicepa.gov.it/ipa-dati/api/3/action

# --- Email (Mailpit in sviluppo: bun run infra:mail, UI http://localhost:8025) ---
# Porte di Mailpit sul computer (compose.local.yaml); SMTP_PORT deve coincidere con
# MAILPIT_SMTP_PORT quando si usa Mailpit.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Usata per i magic link della dashboard e per le email dell'onboarding (PEC)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
EMAIL_FROM=no-reply@developers.italia.it
# Copie delle email di onboarding (facoltative)
# EMAIL_ONBOARDING_CC=
# EMAIL_ONBOARDING_BCC=
# SOLO sviluppo/staging: reindirizza TUTTE le email in uscita a questo indirizzo.
# Non dà accesso alla dashboard (in onboarding-italia la stessa variabile faceva entrambe le cose).
# EMAIL_OVERRIDE_RECIPIENT=
